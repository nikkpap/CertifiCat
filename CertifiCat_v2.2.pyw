    def set_app_icon(self):
        """Set the window icon from ICON_PNG_B64 (safe no-op if missing)."""
        try:
            b64 = _get_b64_or_default("ICON_PNG_B64")
            img = tk.PhotoImage(data=b64, format="png")
            self.iconphoto(True, img)
            # keep a ref to avoid GC
            self._app_icon_ref = img
        except Exception:
            pass

    def show_splash(self, duration_ms: int = 2000, on_close=None):
        """
        Show a centered splash using SPLASH_LOGO_B64 (or placeholder) for duration_ms.
        Calls on_close() after the splash closes (if provided).
        """
        try:
            b64 = _get_b64_or_default("SPLASH_LOGO_B64")
            img = tk.PhotoImage(data=b64, format="png")
        except Exception:
            if on_close:
                self.after(0, on_close)
            return

        splash = tk.Toplevel(self)
        splash.overrideredirect(True)
        splash.attributes("-topmost", True)

        lbl = tk.Label(splash, image=img, borderwidth=0, highlightthickness=0)
        lbl.image = img  # keep ref
        lbl.pack()

        splash.update_idletasks()
        # Center on screen (works even if root is withdrawn)
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        w, h = splash.winfo_width(), splash.winfo_height()
        x, y = (sw - w) // 2, (sh - h) // 2
        splash.geometry(f"+{x}+{y}")

        def _close():
            try:
                splash.destroy()
            finally:
                if on_close:
                    on_close()

        splash.after(duration_ms, _close)

    def start_with_splash(self, duration_ms: int = 2000):
        """Hide the main window, show splash, then reveal and size the app."""
        # Hide the main window before the event loop displays it
        self.withdraw()

        def _after():
            # Show the app after splash finishes
            self.deiconify()
            self.lift()
            try:
                self._fit_window_to_content()
            except Exception:
                pass
            self.update_idletasks()

        # Schedule splash right after Tk loop starts
        self.after(10, lambda: self.show_splash(duration_ms=duration_ms, on_close=_after))

    def _set_badge(self, label: tk.Label, ok: bool):
        label.config(text="✔" if ok else "✘", fg="#22aa22" if ok else "#cc0000")

    def _update_pw_strength(self):
        label, color = _password_strength(self.pw_var.get())
        self.pw_strength.config(text=label, fg=color)

    def _update_cn_status(self):
        cn = self.cn_var.get().strip()
        if cn:
            self.cn_status.config(text="Acceptable", fg="#22aa22")
        else:
            self.cn_status.config(text="Empty", fg="#cc0000")

    def _update_pfx_status(self):
        p = self.pfx_var.get().strip()
        exists = bool(p) and os.path.isfile(p)
        self.pfx_status.config(
            text=("PFX: created ✔" if exists else "PFX: not created ✘"),
            fg=("#22aa22" if exists else "#cc0000")
        )

    def _sync_cer_to_pfx(self):
        pfx = self.pfx_var.get().strip()
        if pfx:
            self.cer_var.set(_default_cer_for_pfx(pfx))

    def _update_status(self):
        exe_ok = _is_valid_exe_file(self.exe_var.get())
        self._set_badge(self.exe_status, exe_ok)

        st_resolved = _resolve_signtool(self.signtool_var.get())
        st_ok = st_resolved is not None and (os.path.isfile(st_resolved) or shutil.which(st_resolved))
        self._set_badge(self.signtool_status, st_ok)

    def _fit_window_to_content(self):
        """Resize height to exactly fit the currently visible widgets."""
        self.update_idletasks()
        req_w = max(760, self.frm.winfo_reqwidth() + 20)
        req_h = self.frm.winfo_reqheight() + 20
        req_h = max(300, req_h)
        self.geometry(f"{req_w}x{req_h}")

    def _set_name_version_labels(self, name_label: ttk.Label, ver_label: ttk.Label):
        name, ver, _ = _app_meta()
        name_label.config(text=name)
        if ver:
            ver_label.config(text=f"v{ver}")
            if hasattr(ver_label, "grid_info") and not ver_label.winfo_ismapped():
                ver_label.grid()  # re-show if previously hidden
        else:
            # no version: hide the version label cleanly
            try:
                ver_label.grid_remove()
            except Exception:
                ver_label.pack_forget()


    # --- Collapsers ---

    def _toggle_cer(self, force=True):
        """Show/hide the .cer tools group (self.cer_frame) cleanly and refit window."""
        show = self.show_cer_var.get()
        if force is False:
            show = False
            self.show_cer_var.set(False)

        # Clear previous placement
        try:
            self.cer_frame.grid_forget()
        except Exception:
            pass
        self.frm.rowconfigure(self.cer_row_index, weight=0, minsize=0)

        if show:
            # Place again
            self.cer_frame.grid(row=self.cer_row_index, column=0, columnspan=3, sticky="nsew")
            # A small minsize so buttons breathe but not too tall
            self.frm.rowconfigure(self.cer_row_index, weight=0, minsize=50)

        self.update_idletasks()
        self._fit_window_to_content()

    def _toggle_cer_tools(self, force=True):
        """Compatibility wrapper for older call sites. Delegates to _toggle_cer()."""
        if force is False:
            # start hidden
            self.show_cer_var.set(False)
        self._toggle_cer()

    def _toggle_log(self, force=True):
        show = self.show_log_var.get()
        if force is False:
            show = False
            self.show_log_var.set(False)

        # Remove log frame and reset row constraints
        try:
            self.log_frame.grid_forget()
        except Exception:
            pass
        self.frm.rowconfigure(self.log_row_index, weight=0, minsize=0)

        if show:
            # Show log and let it expand a bit; height of Text is already set (12 lines)
            self.log_frame.grid(row=self.log_row_index, column=0, columnspan=4, sticky="nsew")
            self.frm.rowconfigure(self.log_row_index, weight=1, minsize=120)

        self.update_idletasks()
        self._fit_window_to_content()

    def log_write(self, text: str):
        if text:
            if not self.show_log_var.get():
                self.show_log_var.set(True)
                self._toggle_log()
            self.log_text.insert("end", text + "\n")
            self.log_text.see("end")
            self.update_idletasks()

