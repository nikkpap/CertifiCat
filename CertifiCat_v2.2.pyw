    def create_pfx(self):
        cn = self.cn_var.get().strip()
        pw = self.pw_var.get().strip()
        pfx = self.pfx_var.get().strip()
        if not cn or not pw or not pfx:
            messagebox.showerror("Error", "Fill CN, password, and PFX path.")
            return

        pfx_dir = os.path.dirname(pfx)
        if pfx_dir and not os.path.exists(pfx_dir):
            try:
                os.makedirs(pfx_dir, exist_ok=True)
            except Exception as e:
                messagebox.showerror("Error", f"Cannot create directory:\n{pfx_dir}\n\n{e}")
                return

        self.log_write(f"Creating self-signed PFX: {pfx}")

        cn_ps  = _ps_escape_double_quotes(cn)
        pw_ps  = _ps_escape_double_quotes(pw)
        pfx_ps = _ps_escape_double_quotes(pfx)

        # Stronger key, exportable private key, 3-year validity
        ps = (
            f"$cert = New-SelfSignedCertificate -Type CodeSigningCert "
            f"-Subject \"CN={cn_ps}\" "
            f"-KeyAlgorithm RSA -KeyLength 3072 "
            f"-KeyExportPolicy Exportable "
            f"-NotAfter (Get-Date).AddYears(3) "
            f"-CertStoreLocation Cert:\\CurrentUser\\My; "
            f"Export-PfxCertificate -Cert $cert -FilePath \"{pfx_ps}\" "
            f"-Password (ConvertTo-SecureString -String \"{pw_ps}\" -Force -AsPlainText) "
            f"| Out-Null"
        )

        rc, out, err = run_ps(ps)
        if out.strip():
            self.log_write(out.strip())
        if rc != 0 or err.strip():
            self.log_write("ERROR: " + err.strip())
            messagebox.showerror("PowerShell Error", err.strip() or "Unknown error")
        else:
            self.log_write("PFX created successfully (RSA-3072, 3 years).")
            if self.log_pw_var.get():
                self.log_write(f"PFX password: {pw}")
            self._update_pfx_status()

    def export_public_cer(self):
        pfx = self.pfx_var.get().strip()
        pw  = self.pw_var.get().strip()
        if not pfx or not os.path.isfile(pfx):
            messagebox.showerror("Export .cer", "Please select an existing .pfx file first.")
            return

        # Ask where to save (.cer)
        default_name = os.path.splitext(os.path.basename(pfx))[0] + ".cer"
        initdir = os.path.dirname(pfx) or os.path.expanduser("~\\Desktop")
        out_path = filedialog.asksaveasfilename(
            parent=self,
            title="Save public certificate (.cer)",
            defaultextension=".cer",
            initialdir=initdir,
            initialfile=default_name,
            filetypes=[("Certificate (*.cer)", "*.cer"), ("All files", "*.*")]
        )
        if not out_path:
            return

        # Ensure folder exists
        try:
            os.makedirs(os.path.dirname(out_path), exist_ok=True)
        except Exception as e:
            messagebox.showerror("Export .cer", f"Cannot create folder:\n{e}")
            return

        # Export via PowerShell (public part from PFX → .cer as DER)
        pfx_ps = _ps_escape_double_quotes(pfx)
        pw_ps  = _ps_escape_double_quotes(pw)
        cer_ps = _ps_escape_double_quotes(out_path)
        ps = (
            f"$data = Get-PfxData -FilePath \"{pfx_ps}\" "
            f"-Password (ConvertTo-SecureString -String \"{pw_ps}\" -Force -AsPlainText); "
            f"$cert = $data.EndEntityCertificates[0]; "
            f"[System.IO.File]::WriteAllBytes(\"{cer_ps}\", $cert.RawData); "
            f"$cert.Thumbprint"
        )
        rc, out, err = run_ps(ps)
        if rc != 0 or err.strip():
            self.log_write("Exporting public .cer FAILED.")
            if err.strip():
                self.log_write(err.strip())
            messagebox.showerror("Export .cer", err.strip() or "Unknown PowerShell error.")
            return

        # Verify on disk
        try:
            exists = os.path.exists(out_path)
            size   = os.path.getsize(out_path) if exists else 0
        except Exception:
            exists, size = False, 0

        if not exists or size == 0:
            self.log_write(f"Exported but verification failed: {out_path}")
            messagebox.showerror("Export .cer", "File write verification failed. The file was not found or is empty.")
            return

        thumb = (out or "").strip().replace(" ", "")
        self.cer_var.set(out_path)
        self.log_write(f"Exporting public .cer to: {out_path}")
        self.log_write(f"CER exported successfully. Size: {size} bytes. Thumbprint: {thumb}")

        # Open Explorer with the file pre-selected (os.startfile cannot pass args → use subprocess)
        if messagebox.askyesno("Export .cer", f"Exported successfully:\n\n{out_path}\n\nOpen in Explorer?"):
            try:
                subprocess.Popen(["explorer.exe", "/select,", out_path], **_no_window_kwargs())
            except Exception:
                # Fallback: open folder
                try:
                    subprocess.Popen(["explorer.exe", os.path.dirname(out_path)], **_no_window_kwargs())
                except Exception:
                    pass

    def install_trusted_root(self):
        cer = self.cer_var.get().strip()
        pfx = self.pfx_var.get().strip()
        pw  = self.pw_var.get().strip()

        # --- Ensure we have a .cer (export from .pfx if needed)
        temp_cer = None
        if not (cer and os.path.isfile(cer)):
            if not os.path.isfile(pfx):
                messagebox.showerror("Error", "No .cer selected and the PFX file is missing.")
                return
            fd, temp_cer = tempfile.mkstemp(suffix=".cer"); os.close(fd)
            cer = temp_cer
            self.cer_var.set(cer)
            self.log_write("No .cer found; exporting a temporary .cer from the .pfx...")
            pfx_ps = _ps_escape_double_quotes(pfx)
            pw_ps  = _ps_escape_double_quotes(pw)
            cer_ps = _ps_escape_double_quotes(cer)
            ps_export = (
                f"$data = Get-PfxData -FilePath \"{pfx_ps}\" "
                f"-Password (ConvertTo-SecureString -String \"{pw_ps}\" -Force -AsPlainText); "
                f"$cert = $data.EndEntityCertificates[0]; "
                f"[System.IO.File]::WriteAllBytes(\"{cer_ps}\", $cert.RawData)"
            )
            rc, out, err = run_ps(ps_export)
            if out.strip(): self.log_write(out.strip())
            if rc != 0:
                self.log_write("ERROR: " + (err.strip() or "Failed exporting .cer from .pfx"))
                messagebox.showerror("PowerShell Error", err.strip() or "Failed exporting .cer from .pfx")
                if temp_cer and os.path.exists(temp_cer):
                    try: os.remove(temp_cer)
                    except Exception: pass
                return

        # --- Get Thumbprint
        cer_ps = _ps_escape_double_quotes(cer)
        ps_thumb = (
            "$bytes=[System.IO.File]::ReadAllBytes(\"" + cer_ps + "\");"
            "$c=[System.Security.Cryptography.X509Certificates.X509Certificate2]::new($bytes);"
            "$c.Thumbprint"
        )
        rc, thumb, err = run_ps(ps_thumb)
        thumb = (thumb or "").strip().replace(" ", "")
        if rc != 0 or not thumb:
            self.log_write("ERROR: Could not read certificate thumbprint. " + (err.strip() if err else ""))
            messagebox.showerror("Certificate Error", "Could not read certificate thumbprint from .cer.")
            if temp_cer and os.path.exists(temp_cer):
                try: os.remove(temp_cer)
                except Exception: pass
            return
        self.log_write(f"Thumbprint: {thumb}")

        # --- Helper to check store
        def _present_in_store(store: str) -> bool:
            ps = (
                f"$t='{thumb}';"
                f"$s=Get-ChildItem Cert:\\CurrentUser\\{store} | Where-Object Thumbprint -eq $t;"
                f"if($s){{'YES'}} else {{'NO'}}"
            )
            rcx, outx, _ = run_ps(ps)
            return (rcx == 0 and (outx or "").strip() == "YES")

        # Which stores are missing
        need_root = not _present_in_store("Root")
        need_pub  = not _present_in_store("TrustedPublisher")
        if not need_root and not need_pub:
            self.log_write("Certificate already present in both stores. Nothing to do.")
            messagebox.showinfo("Success", "Certificate is already installed and trusted ✅")
            return

        self.log_write("Installing certificate to CurrentUser stores (Root, TrustedPublisher)...")

        # ---- Try Import-Certificate
        parts = []
        if need_root:
            parts.append(f"Import-Certificate -FilePath \"{cer_ps}\" -CertStoreLocation Cert:\\CurrentUser\\Root | Out-Null")
        if need_pub:
            parts.append(f"Import-Certificate -FilePath \"{cer_ps}\" -CertStoreLocation Cert:\\CurrentUser\\TrustedPublisher | Out-Null")
        if parts:
            rc1, out1, _ = run_ps(";".join(parts))
            if out1.strip(): self.log_write(out1.strip())
            need_root = not _present_in_store("Root")
            need_pub  = not _present_in_store("TrustedPublisher")

        # ---- certutil fallback
        if need_root or need_pub:
            certutil = shutil.which("certutil")
            if certutil:
                self.log_write("Import-Certificate failed; trying certutil...")
                kw = dict(stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                kw.update(_no_window_kwargs())
                if need_root:
                    p = subprocess.Popen([certutil, "-user", "-addstore", "Root", cer], **kw)
                    out2, _ = p.communicate()
                    if out2.strip(): self.log_write(out2.strip())
                    need_root = not _present_in_store("Root")
                if need_pub:
                    p2 = subprocess.Popen([certutil, "-user", "-addstore", "TrustedPublisher", cer], **kw)
                    out3, _ = p2.communicate()
                    if out3.strip(): self.log_write(out3.strip())
                    need_pub = not _present_in_store("TrustedPublisher")

        # ---- .NET fallback
        if need_root or need_pub:
            self.log_write("certutil failed; trying .NET X509Store add.")
            ps_dotnet = [
                "$bytes=[System.IO.File]::ReadAllBytes('" + cer_ps + "');",
                "$cert=[System.Security.Cryptography.X509Certificates.X509Certificate2]::new($bytes);"
            ]
            if need_root:
                ps_dotnet += [
                    "$r=New-Object System.Security.Cryptography.X509Certificates.X509Store('Root','CurrentUser');",
                    "$r.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite);$r.Add($cert);$r.Close();"
                ]
            if need_pub:
                ps_dotnet += [
                    "$p=New-Object System.Security.Cryptography.X509Certificates.X509Store('TrustedPublisher','CurrentUser');",
                    "$p.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite);$p.Add($cert);$p.Close();"
                ]
            rc3, out3, err3 = run_ps("".join(ps_dotnet))
            if out3.strip(): self.log_write(out3.strip())
            if rc3 != 0 and (err3 or "").strip():
                self.log_write("ERROR: " + err3.strip())
                messagebox.showerror("Certificate Install Error", err3.strip() or "Unknown error")

        # ---- ✅ FINAL VALIDATION
        final_root = _present_in_store("Root")
        final_pub  = _present_in_store("TrustedPublisher")

        if final_root and final_pub:
            self.log_write("✅ Certificate installed successfully to both stores.")
            messagebox.showinfo("Success", "Certificate installed and trusted successfully ✅")
        else:
            missing = []
            if not final_root: missing.append("Trusted Root")
            if not final_pub:  missing.append("Trusted Publisher")
            self.log_write("❌ Missing from: " + ", ".join(missing))
            messagebox.showerror("Certificate Install Error", "Certificate not found in: " + ", ".join(missing))

        if temp_cer and os.path.exists(temp_cer):
            try: os.remove(temp_cer)
            except Exception: pass


    # --- Sign logic ---

    def sign_auto(self):
        """If EXE field is valid, sign that file; else ask for multiple EXEs and sign them."""
        exe_field = self.exe_var.get().strip()
        if _is_valid_exe_file(exe_field):
            self._sign_many([exe_field])
        else:
            files = filedialog.askopenfilenames(filetypes=[("EXE", "*.exe")], title="Select EXE(s) to sign")
            if not files:
                return
            self._sign_many(list(files))

    def _sign_many(self, files):
        pfx = self.pfx_var.get().strip()
        pw  = self.pw_var.get().strip()
        ts  = self.ts.get().strip()

        signtool_user = self.signtool_var.get().strip()
        signtool = _resolve_signtool(signtool_user)
        if signtool is None:
            messagebox.showerror(
                "Error",
                "signtool.exe not found.\n\n"
                "Place 'signtool.exe' next to this GUI or in a 'tools' subfolder,\n"
                "or install the Windows 10/11 SDK / Visual Studio Build Tools."
            )
            return

        if not all([pfx, pw]):
            messagebox.showerror("Error", "Provide PFX path and password first.")
            return
        if not os.path.exists(pfx):
            messagebox.showerror("Error", f"PFX not found:\n{pfx}")
            return

        success, fail = 0, 0
        for exe in files:
            if not _is_valid_exe_file(exe):
                self.log_write(f"Skipping (not an EXE): {exe}")
                fail += 1
                continue

            self.log_write(f"Signing: {exe}")
            cmd = [
                signtool, "sign",
                "/f", pfx,
                "/p", pw,
                "/tr", ts,
                "/td", "sha256",
                "/fd", "sha256",
                exe
            ]
            try:
                kw = dict(stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                kw.update(_no_window_kwargs())
                p = subprocess.Popen(cmd, **kw)
                out, err = p.communicate()
                if out.strip():
                    self.log_write(out.strip())
                if p.returncode != 0 or err.strip():
                    if err.strip():
                        self.log_write("ERROR: " + err.strip())
                    fail += 1
                else:
                    self.log_write("OK")
                    success += 1
            except Exception as e:
                self.log_write(f"ERROR: {e}")
                fail += 1

        if len(files) > 1:
            self.log_write(f"Batch done. Success: {success}, Failed: {fail}")
        elif len(files) == 1 and success == 1:
            self.log_write("Signed successfully.")

