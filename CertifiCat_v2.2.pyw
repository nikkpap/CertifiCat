        self.resizable(False, False)

        pad = {"padx": 8, "pady": 6}

        self.frm = ttk.Frame(self)
        self.frm.pack(fill="both", expand=True, **pad)

        # Vars for live validation
        self.exe_var       = tk.StringVar()
        self.signtool_var  = tk.StringVar(value=_find_signtool())
        self.pfx_var       = tk.StringVar(value=os.path.join(os.path.expanduser("~"), "Desktop", "nikkpap_self-cert_2025.pfx"))
        self.cer_var       = tk.StringVar(value=_default_cer_for_pfx(self.pfx_var.get()))
        self.pw_var        = tk.StringVar(value="PAOK4ever!@#")
