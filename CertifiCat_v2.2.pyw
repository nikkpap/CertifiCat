# --- Force GUI mode: if a console is attached, relaunch via pythonw.exe and exit ---
if os.name == "nt":
    try:
        import ctypes, sys, subprocess
        get_console = getattr(ctypes.windll.kernel32, "GetConsoleWindow", None)
        has_console = bool(get_console and get_console())
        if has_console:
            # Resolve pythonw.exe next to the current Python
            exe = sys.executable
            base = os.path.dirname(exe)
            candidates = [
                os.path.join(base, "pythonw.exe"),
                r"C:\Program Files\Python313\pythonw.exe",
                r"C:\Program Files (x86)\Python313\pythonw.exe",
            ]
            pyw = next((p for p in candidates if os.path.exists(p)), None)
            if pyw:
                script = os.path.abspath(sys.argv[0])
                args = [pyw, script] + sys.argv[1:]
                # Launch hidden
                si = subprocess.STARTUPINFO(); si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
                creation = getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000)
                subprocess.Popen(args, startupinfo=si, creationflags=creation)
                # Kill this console-bound process immediately
                os._exit(0)
    except Exception:
        # If anything goes wrong, just continue; app will still work
        pass


