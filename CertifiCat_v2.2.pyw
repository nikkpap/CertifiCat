        self.log_pw_var    = tk.BooleanVar(value=False)
        self.show_cer_tools_var = tk.BooleanVar(value=False)

        self._build_form()

        # Traces for live updates
        self.exe_var.trace_add("write", lambda *_: self._update_status())
        self.signtool_var.trace_add("write", lambda *_: self._update_status())
        self.pfx_var.trace_add("write", lambda *_: (self._update_pfx_status(), self._sync_cer_to_pfx()))
        self.pw_var.trace_add("write", lambda *_: self._update_pw_strength())
        self.cn_var.trace_add("write", lambda *_: self._update_cn_status())

