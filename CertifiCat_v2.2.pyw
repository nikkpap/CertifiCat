def _app_meta():
    """
    Returns (name, version, title) from APP_NAME/APP_VERSION if present,
    else soft defaults derived from filename.
    """
    
    name = globals().get("APP_NAME")
    if not name:
        name = os.path.splitext(os.path.basename(sys.argv[0] or "App"))[0]
    ver  = globals().get("APP_VERSION")
    title = f"{name} v{ver}" if ver else name
    return name, ver, title

def _get_b64_or_default(var_name: str) -> str:
    """
    Fetch base64 image string by name (e.g., 'ICON_PNG_B64').
    Falls back to PLACEHOLDER_PNG_B64 if defined, else to a tiny transparent PNG.
    """
    val = globals().get(var_name)
    if isinstance(val, str) and val.strip():
        return val
    ph = globals().get("PLACEHOLDER_PNG_B64")
    if isinstance(ph, str) and ph.strip():
        return ph
    return _DEFAULT_BLANK_PNG_B64

def _no_window_kwargs():
    """Hide child process console windows (PowerShell, signtool) on Windows."""
    kw = {}
    if hasattr(subprocess, "STARTUPINFO"):
        si = subprocess.STARTUPINFO()
        si.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        kw["startupinfo"] = si
    if hasattr(subprocess, "CREATE_NO_WINDOW"):
        kw["creationflags"] = subprocess.CREATE_NO_WINDOW
    return kw

def run_ps(ps_command: str):
    """Run a PowerShell command hidden and return (rc, stdout, stderr)."""
    ps_exe = _get_powershell_exe()
    full = [
        ps_exe,
        "-WindowStyle", "Hidden",
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
    ]
    # PowerShell 5 & 7 both accept -ExecutionPolicy Bypass on Windows; on non-Windows it’s ignored.
    if os.name == "nt":
        full += ["-ExecutionPolicy", "Bypass"]
    full += ["-Command", ps_command]

    kw = dict(stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    kw.update(_no_window_kwargs())
    p = subprocess.Popen(full, **kw)
    out, err = p.communicate()
    return p.returncode, out, err

def _ps_escape_double_quotes(s: str) -> str:
    """Escape double quotes for use inside a PowerShell double-quoted string."""
    return (s or "").replace('"', '`"')

def _here() -> str:
    try:
        return os.path.dirname(os.path.abspath(__file__))
    except NameError:
        return os.getcwd()

def _find_signtool() -> str:
    """
    Locate signtool.exe in:
      1) same folder as this GUI
      2) a 'tools' subfolder
      3) Windows 10/11 SDK (Windows Kits) common install paths
      4) Legacy ClickOnce SDK path
      5) PATH (via shutil.which)
    Returns a path or 'signtool' fallback.
    """
    base = _here()
    candidates = [
        os.path.join(base, "signtool.exe"),
        os.path.join(base, "tools", "signtool.exe"),
    ]

    # Windows Kits (SDK) typical locations
    if os.name == "nt":
        kits_root = os.path.join(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"),
                                 "Windows Kits", "10", "bin")
        if os.path.isdir(kits_root):
            try:
                # Pick highest version dir first
                versions = sorted(
                    (d for d in os.listdir(kits_root) if os.path.isdir(os.path.join(kits_root, d))),
                    reverse=True
                )
                for ver in versions:
                    for arch in ("x64", "x86", "arm64"):
                        p = os.path.join(kits_root, ver, arch, "signtool.exe")
                        if os.path.isfile(p):
                            candidates.append(p)
            except Exception:
                pass

        # Older ClickOnce SDK
        legacy = os.path.join(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"),
                              "Microsoft SDKs", "ClickOnce", "SignTool", "signtool.exe")
        if os.path.isfile(legacy):
            candidates.append(legacy)

    for c in candidates:
        if os.path.isfile(c):
            return c

    w = shutil.which("signtool.exe") or shutil.which("signtool")
    return w if w else "signtool"

def _resolve_signtool(user_value: str):
    """
    Resolve the signtool path for validation:
    - existing file path → ok
    - 'signtool' or empty → try PATH or local discovery
    Returns absolute path if resolved, else None.
    """
    val = (user_value or "").strip()
    if val and os.path.isfile(val):
        return os.path.abspath(val)

    found = _find_signtool()
    if found and (os.path.isfile(found) or shutil.which(found)):
        return found

    if val.lower() == "signtool":
        w = shutil.which("signtool")
        if w:
            return w
    return None

def _is_valid_exe_file(path: str) -> bool:
    return bool(path) and os.path.isfile(path) and path.lower().endswith(".exe")

def _password_strength(pw: str):
    """
    Simple strength estimator: returns (label, color).
    Factors: length, lower/upper/digit/symbol variety.
    """
    import re as _re
    if not pw:
        return "Empty", "#888888"

    length = len(pw)
    lower = bool(_re.search(r"[a-z]", pw))
    upper = bool(_re.search(r"[A-Z]", pw))
    digit = bool(_re.search(r"\d", pw))
    symb  = bool(_re.search(r"[^A-Za-z0-9]", pw))

    score = 0
    if length >= 16: score += 3
    elif length >= 12: score += 2
    elif length >= 8: score += 1
    score += sum([lower, upper, digit, symb])

    if length < 8:
        return "Very weak", "#cc0000"
    if score <= 3:   return "Weak", "#cc5500"
    if score == 4:   return "Okay", "#c0a000"
    if score == 5:   return "Strong", "#22aa22"
    if score >= 6:   return "Very strong", "#107010"
    return "Weak", "#cc5500"

def _default_cer_for_pfx(pfx_path: str) -> str:
    if not pfx_path:
        return os.path.join(os.path.expanduser("~"), "Desktop", "self-cert.cer")
    base, _ = os.path.splitext(pfx_path)
    return base + ".cer"

def _get_powershell_exe() -> str:
    """
    Prefer pwsh (PowerShell 7+) if available; otherwise use Windows PowerShell.
    Falls back to 'powershell' which typically resolves on Windows PATH.
    """
    try:
        if os.name == "nt":
            # Try modern PowerShell first
            pwsh = shutil.which("pwsh.exe") or shutil.which("pwsh")
            if pwsh and os.path.isfile(pwsh):
                return pwsh
            # Then classic Windows PowerShell
            ps = shutil.which("powershell.exe") or shutil.which("powershell")
            if ps and os.path.isfile(ps):
                return ps
            # Well-known system location
            sysroot = os.environ.get("SystemRoot", r"C:\Windows")
            candidate = os.path.join(sysroot, "System32", "WindowsPowerShell", "v1.0", "powershell.exe")
            if os.path.isfile(candidate):
                return candidate
        else:
            # Non-Windows (for completeness): try pwsh then powershell
            for name in ("pwsh", "powershell"):
                p = shutil.which(name)
                if p and os.path.isfile(p):
                    return p
    except Exception:
        pass
    return "powershell"

